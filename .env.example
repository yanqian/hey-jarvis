# Copy this file to .env and replace placeholder values.
OPENAI_API_KEY=your_api_key_here

# Backend selection. Pipeline remains the default; Realtime WebRTC is opt-in.
# Realtime is billable. Arm Chrome once per host launch; pre-wake audio stays local.
# macOS packaging/signing/notarization are deferred for this developer MVP.
BACKEND=pipeline
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=alloy
# Direct browser playback gain. Repeat M057 if the room or speaker level changes.
REALTIME_OUTPUT_VOLUME=0.5
REALTIME_IDLE_TIMEOUT_SECONDS=60
REALTIME_MAX_DURATION_SECONDS=600
REALTIME_SERVER_VAD_ENABLED=1
REALTIME_SERVER_VAD_THRESHOLD=0.8
# far_field suits the built-in Mac speaker/mic path; use near_field for a headset, or none.
REALTIME_INPUT_NOISE_REDUCTION=far_field
REALTIME_INPUT_TRANSCRIPTION_ENABLED=1
# cached (default) overlaps the selected local Realtime-quality ACK with connection.
# realtime keeps the paid same-session ACK; local keeps the prior afplay rollback.
REALTIME_ACKNOWLEDGEMENT_MODE=cached
# cached (default) plays the owner-selected local Mandarin “再见”.
# realtime restores a generated same-session farewell.
REALTIME_FAREWELL_MODE=cached
# Bounded local lifecycle diagnostics; content/audio/secrets remain excluded.
REALTIME_DEBUG=0
REALTIME_END_PHRASES=结束对话,再见,goodbye,end conversation
REALTIME_BRIDGE_HOST=127.0.0.1
REALTIME_BRIDGE_PORT=8770

# Wake-word configuration.
WAKE_BACKEND=openwakeword
WAKE_MODEL=hey_jarvis
WAKE_INFERENCE_FRAMEWORK=tflite
WAKE_PHRASE=hey jarvis
WAKE_THRESHOLD=0.5
WAKE_VAD_THRESHOLD=
VAD_BACKEND=disabled
VAD_MODE=2
WAKE_DEBUG=0
WAKE_ACKNOWLEDGEMENT_ENABLED=1
WAKE_ACKNOWLEDGEMENT_TEXT=嗯
WAKE_ACKNOWLEDGEMENT_AUDIO_PATH=var/ack.mp3
WAKE_ACKNOWLEDGEMENT_MAX_DURATION_SECONDS=0.8
WAKE_ACKNOWLEDGEMENT_DRAIN_SECONDS=0.35
ACK_GUARD_ENABLED=1
ACK_GUARD_MIN_QUIET_SECONDS=0.16
ACK_GUARD_QUIET_RMS=900
ACK_GUARD_MAX_BUFFER_SECONDS=1.50
POST_PLAYBACK_WAKE_COOLDOWN_SECONDS=1.0
POST_PLAYBACK_QUIET_SECONDS=0.5
POST_PLAYBACK_QUIET_RMS=500
POST_PLAYBACK_MAX_SUPPRESSION_SECONDS=6.0
WAKE_CONFIRMATION_FRAMES=2
# Realtime-only, content-free wake evidence. Both values are required to write files.
WAKE_DIAGNOSTICS_ENABLED=0
WAKE_DIAGNOSTICS_DIR=
ARMED_NO_SPEECH_TIMEOUT_SECONDS=2.0
ARMED_VOICE_RMS=750
ARMED_MIN_RMS=750
ARMED_SNR_MULTIPLIER=2.5
ARMED_VOICE_WINDOW_SECONDS=0.30
ARMED_VOICE_REQUIRED_RATIO=0.75
ARMED_CLIP_REJECT_PEAK=32000
ARMED_PRE_ROLL_SECONDS=0.50
ARMED_BASELINE_SECONDS=0.30
ARMED_BASELINE_MIN_CHUNKS=3
ARMED_REQUIRE_BASELINE=1
ARMED_LAST_CHUNK_MUST_BE_VOICED=1
ARMED_VAD_REQUIRED_RATIO=0.50
ARMED_VAD_MIN_FRAMES=2
RECORDING_VAD_ENABLED=0
RECORDING_VAD_END_RATIO=0.25
RECORDING_VAD_SPEECH_RATIO=0.50
RECORDING_HANGOVER_SECONDS=0.30
RECORDING_END_SILENCE_SECONDS=1.5
MIN_VALID_SPEECH_SECONDS=0.50
MIN_TRANSCRIPT_LENGTH=2
CANCEL_PHRASES=取消,没事,不用了,算了,stop,cancel,never mind

# Recording configuration.
SILENCE_SECONDS=1.5
MAX_RECORD_SECONDS=20
RECORDING_SILENCE_RMS=750
SAMPLE_RATE=16000

# OpenAI model configuration.
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
CHAT_MODEL=gpt-4o-mini
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
TTS_INSTRUCTIONS=模仿一位经验丰富的中文普通话科普主播，语速适中，自然。
TTS_SPEED=1.0

# Structured local tools.
ENABLE_TOOLS=1
TOOL_ROUTER_DEBUG=0
TOOL_ANSWER_NATURALIZATION=1
WEATHER_PROVIDER=open-meteo
FX_PROVIDER=frankfurter
STOCK_PROVIDER=finnhub
TOOL_HTTP_TIMEOUT_SECONDS=5
DEFAULT_LOCATION=Singapore
DEFAULT_BASE_CURRENCY=USD
FINNHUB_API_KEY=
