# Copy this file to .env and replace placeholder values.
OPENAI_API_KEY=your_api_key_here

# Wake-word configuration.
WAKE_BACKEND=openwakeword
WAKE_MODEL=alexa
WAKE_INFERENCE_FRAMEWORK=tflite
WAKE_PHRASE=alexa
WAKE_THRESHOLD=0.5
WAKE_DEBUG=0
POST_PLAYBACK_WAKE_COOLDOWN_SECONDS=1.0
POST_PLAYBACK_QUIET_SECONDS=0.5
POST_PLAYBACK_QUIET_RMS=500
POST_PLAYBACK_MAX_SUPPRESSION_SECONDS=6.0
WAKE_CONFIRMATION_FRAMES=2

# Recording configuration.
SILENCE_SECONDS=1.5
MAX_RECORD_SECONDS=20
SAMPLE_RATE=16000

# OpenAI model configuration.
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
CHAT_MODEL=gpt-4o-mini
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
TTS_INSTRUCTIONS=模仿一位经验丰富的中文普通话科普主播，语速适中，自然。
TTS_SPEED=1.0
