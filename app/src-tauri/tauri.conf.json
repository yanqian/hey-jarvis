{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hey Jarvis",
  "version": "0.1.0",
  "identifier": "com.heyjarvis.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hey Jarvis",
        "width": 820,
        "height": 640,
        "minWidth": 480,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; script-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../../assets/wake_acknowledgement_alloy.mp3": "assets/wake_acknowledgement_alloy.mp3",
      "../../assets/realtime_acknowledgement_alloy_zh.wav": "assets/realtime_acknowledgement_alloy_zh.wav",
      "../../assets/realtime_acknowledgement_alloy_zh.json": "assets/realtime_acknowledgement_alloy_zh.json",
      "../../assets/realtime_farewell_alloy_zh.wav": "assets/realtime_farewell_alloy_zh.wav",
      "../../assets/realtime_farewell_alloy_zh.json": "assets/realtime_farewell_alloy_zh.json",
      "../../assets/realtime_acknowledgement_alloy_en.wav": "assets/realtime_acknowledgement_alloy_en.wav",
      "../../assets/realtime_acknowledgement_alloy_en.json": "assets/realtime_acknowledgement_alloy_en.json",
      "../../assets/realtime_farewell_alloy_en.wav": "assets/realtime_farewell_alloy_en.wav",
      "../../assets/realtime_farewell_alloy_en.json": "assets/realtime_farewell_alloy_en.json",
      "../../build/macos-sidecar/hey-jarvis-sidecar": "sidecar",
      "../../build/macos-sidecar/manifests": "packaging-manifests"
    },
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
