{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hey Jarvis",
  "version": "0.1.0",
  "identifier": "com.heyjarvis.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hey Jarvis",
        "width": 760,
        "height": 640,
        "minWidth": 620,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; script-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["app"],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
